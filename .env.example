# Sao chép thành .env (không commit) nếu muốn đổi thông tin đăng nhập PostgreSQL của môi trường E-LOCAL.
# Đây là database cục bộ dùng một lần trong docker compose — KHÔNG dùng thông tin của Neon ở đây.
TADSS_PG_USER=tadss
TADSS_PG_PASSWORD=tadss_local

# ── Secret khi chạy trong container / qua ngrok (gói 5.3, T5.30 — compose chưa đọc các biến này) ──
# appsettings.Development.json KHÔNG có trong image (.dockerignore) nên secret phải đi qua biến môi trường,
# compose ánh xạ: TADSS_DB_CONNECTION -> ConnectionStrings__DefaultConnection,
#                 TADSS_REDIS_CONNECTION -> Tadss__Cache__RedisConnectionString.
# Chỉ điền giá trị thật vào .env (không commit). Không bao giờ bật Tadss__Database__ApplyMigrationsOnStartup với Neon.
# TADSS_DB_CONNECTION=Host=your-db-host;Port=5432;Database=neondb;Username=your-user;Password=your-password;SSL Mode=Require
# TADSS_REDIS_CONNECTION=your-redis-host:11082,user=default,password=your-redis-password
# NGROK_AUTHTOKEN=your-ngrok-token
