# ==============================================================================
# TADSS-Runtime Environment Configuration Template
# Sao chép file này thành .env hoặc nạp biến môi trường tương ứng khi chạy Docker
# ==============================================================================

# Môi trường chạy (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# Chuỗi kết nối PostgreSQL (Neon Cloud hoặc Local PostgreSQL)
TADSS_DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=tadss_db;Username=postgres;Password=postgres;SSL Mode=Prefer;

# Chuỗi kết nối Redis Cache cho TADSS Decision Cache
TADSS_REDIS_CONNECTION_STRING=localhost:6380
