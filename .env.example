# Sao chép thành .env (không commit). Compose đọc các biến dưới đây (docker-compose.yml + docker-compose.ngrok.yml + docker-compose.neon.yml).
# Không có .env thì compose base chạy đúng môi trường E-LOCAL mặc định.

# ── E-LOCAL: thông tin đăng nhập PostgreSQL ──
# Đây là database cục bộ dùng một lần trong docker compose — KHÔNG dùng thông tin của Neon ở đây.
TADSS_PG_USER=tadss
TADSS_PG_PASSWORD=tadss_local

# ── Expose qua ngrok / database ngoài (gói 5.3, T5.30) ──
# appsettings.Development.json KHÔNG có trong image (.dockerignore) nên secret phải đi qua biến môi trường.
# Compose ánh xạ: TADSS_DB_CONNECTION    -> ConnectionStrings__DefaultConnection (docker-compose.neon.yml)
#                 TADSS_REDIS_CONNECTION -> Tadss__Cache__RedisConnectionString (docker-compose.neon.yml)
#                 TADSS_API_KEY_SHA256   -> Tadss__Security__ApiKeys__0__KeySha256
# Chỉ điền giá trị thật vào .env (không commit). docker-compose.neon.yml ép Tadss__Database__ApplyMigrationsOnStartup=false.
# ngrok:  docker compose -f docker-compose.yml -f docker-compose.ngrok.yml --profile ngrok up -d --build
# Neon:   thêm -f docker-compose.neon.yml (chế độ B: TADSS_DB_CONNECTION và TADSS_API_KEY_SHA256 bắt buộc; dùng riêng với base cũng được, file này ép Staging và cổng loopback).
# Authtoken của ngrok (bắt buộc cho docker-compose.ngrok.yml)
NGROK_AUTHTOKEN=
# Domain tĩnh của ngrok (tùy chọn; để trống thì ngrok cấp domain ngẫu nhiên)
NGROK_DOMAIN=
# Chuỗi kết nối PostgreSQL ngoài (bắt buộc cho docker-compose.neon.yml), dạng:
# Host=your-db-host;Port=5432;Database=neondb;Username=your-user;Password=your-password;SSL Mode=Require
TADSS_DB_CONNECTION=
# SHA-256 (hex 64 ký tự) của API key dùng khi expose (bắt buộc cho docker-compose.ngrok.yml và docker-compose.neon.yml; KHÔNG dùng mã băm của khóa local công khai).
# Sinh khóa và mã băm:  key=$(openssl rand -hex 32); printf %s "$key" | openssl dgst -sha256   (đưa khóa cho SmashCourt-BE, mã băm vào đây)
TADSS_API_KEY_SHA256=
# Chế độ B (tùy chọn): Redis ngoài, dạng your-redis-host:11082,user=default,password=your-redis-password ; để trống thì dùng tadss-redis của compose
TADSS_REDIS_CONNECTION=
# ClientId của API key khi expose (mặc định smashcourt-be)
# TADSS_API_CLIENT_ID=smashcourt-be

# ── Cổng host (mặc định như bên dưới; đổi để chạy song song với stack khác) ──
# TADSS_PORT=8081
# TADSS_PG_PORT=5433
# TADSS_REDIS_PORT=6380
# TADSS_TOXIPROXY_PORT=8474
# TADSS_GRAFANA_PORT=3001

# ── Image (mặc định như bên dưới) ──
# TADSS_POSTGRES_IMAGE=postgres:16.15-alpine
# TADSS_REDIS_IMAGE=redis:7.4-alpine
# TADSS_TOXIPROXY_IMAGE=ghcr.io/shopify/toxiproxy:2.12.0
# TADSS_GRAFANA_IMAGE=grafana/otel-lgtm:0.34.0
# TADSS_NGROK_IMAGE=ngrok/ngrok:3.39.11-alpine@sha256:187e588f6c4efe3b29cd3eea9fcd768a1afa7342319e3cee9aeb5af6a9cf64fd
