{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadss.smashcourt.vn/schemas/v1/decision-result.schema.json",
  "title": "DecisionResult",
  "description": "Payload returned by TADSS indicating the evaluation result of a reservation request.",
  "type": "object",
  "required": [
    "decisionId",
    "reservationId",
    "status",
    "strategyName",
    "strategyVersion",
    "executionTimeMs",
    "fallbackUsed",
    "primaryReason",
    "reasons",
    "recommendations",
    "evaluatedAt"
  ],
  "properties": {
    "decisionId": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier of this evaluation cycle generated by TADSS."
    },
    "reservationId": {
      "type": "string",
      "format": "uuid",
      "description": "Echoed reservation identifier from request."
    },
    "status": {
      "type": "string",
      "enum": ["APPROVED", "REJECTED", "NEED_APPROVAL", "Approved", "Rejected", "NeedApproval"],
      "description": "Automated business decision outcome."
    },
    "strategyName": {
      "type": "string",
      "description": "Name of the strategy executed."
    },
    "strategyVersion": {
      "type": "string",
      "description": "Version of the strategy executed."
    },
    "executionTimeMs": {
      "type": "integer",
      "minimum": 0,
      "description": "Strategy calculation execution time in milliseconds."
    },
    "fallbackUsed": {
      "type": "boolean",
      "description": "True if decision was produced by safety fallback strategy."
    },
    "primaryReason": {
      "type": "string",
      "description": "Standard machine-readable reason code."
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Human-readable explanation messages."
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "decision-recommendation.schema.json"
      },
      "description": "List of alternative options or adjustments."
    },
    "evaluatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "Evaluation completion timestamp in UTC."
    }
  },
  "additionalProperties": false
}
