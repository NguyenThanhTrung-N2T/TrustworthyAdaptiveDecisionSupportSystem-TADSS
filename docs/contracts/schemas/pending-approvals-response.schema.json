{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadss.smashcourt.vn/schemas/v1/pending-approvals-response.schema.json",
  "title": "PendingApprovalsResponse",
  "description": "Paginated list of decisions waiting for human manager review.",
  "type": "object",
  "required": [
    "page",
    "pageSize",
    "totalItems",
    "totalPages",
    "items"
  ],
  "properties": {
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "totalItems": {
      "type": "integer",
      "minimum": 0
    },
    "totalPages": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "decisionId",
          "reservationId",
          "status",
          "primaryReason",
          "strategyName",
          "strategyVersion",
          "executionTimeMs",
          "fallbackUsed",
          "createdAt"
        ],
        "properties": {
          "decisionId": { "type": "string", "format": "uuid" },
          "reservationId": { "type": "string", "format": "uuid" },
          "status": { "type": "string", "enum": ["NEED_APPROVAL"] },
          "primaryReason": { "type": "string" },
          "strategyName": { "type": "string" },
          "strategyVersion": { "type": "string" },
          "executionTimeMs": { "type": "integer" },
          "fallbackUsed": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
