<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TADSS.Runtime.Api\TADSS.Runtime.Api.csproj" />
  </ItemGroup>

  <!-- C-11: dùng lại helper test của UnitTests (một nguồn duy nhất, không sao chép, không thêm project) -->
  <ItemGroup>
    <Compile Include="..\TADSS.UnitTests\TestData\ContractSchemas.cs" Link="SharedTestData\ContractSchemas.cs" />
    <Compile Include="..\TADSS.UnitTests\TestData\RepositoryPaths.cs" Link="SharedTestData\RepositoryPaths.cs" />
    <Compile Include="..\TADSS.UnitTests\TestData\RequestSchemaNegativeCases.cs" Link="SharedTestData\RequestSchemaNegativeCases.cs" />
    <Compile Include="..\TADSS.UnitTests\TestData\ContractSamples.cs" Link="SharedTestData\ContractSamples.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="Testcontainers.Toxiproxy" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.analyzers" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="GitHubActionsTestLogger">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
