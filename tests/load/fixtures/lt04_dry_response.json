        "depositRate": 0.3,
        "depositAmount": 68400,
        "depositSource": "TADSS"
      },
      "expect": "ok"
    },
    {
      "name": "tadss làm tròn nửa đồng lên (100.005 × 0,3 = 30.001,5 ⇒ 30.002)",
