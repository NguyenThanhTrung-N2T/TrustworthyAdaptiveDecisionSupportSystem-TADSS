    {
      "name": "tadss sai rate (response 0.5, kỳ vọng 0.3)",
      "env": {
        "LT04_EXPECT": "tadss",
        "LT04_EXPECTED_RATE": "0.3",
        "LT04_STRATEGY": "DefaultDecisionStrategy 2.1.0",
        "LT04_EXPECTED_RATE_SOURCE": "appsettings.json@commit StandardDepositRate"
      },
      "booking": {
        "status": "PENDING",
        "finalTotal": 228000,
