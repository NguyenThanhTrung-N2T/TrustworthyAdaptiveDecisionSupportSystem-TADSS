    {
      "id": 2,
      "type": "stat",
      "title": "Tỉ lệ request ≤ 150 ms (POST quyết định)",
      "description": "Phần request POST /api/v2/decisions xong trong 150 ms (cửa sổ 5 phút), tính trực tiếp từ bucket le=150; ngưỡng SC1 là ≥ 95 %.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(tadss_decision_duration_milliseconds_bucket{le=\"150\",endpoint=\"POST api/v2/decisions\",instance=~\"$instance\"}[5m])) / sum(rate(tadss_decision_duration_milliseconds_count{endpoint=\"POST api/v2/decisions\",instance=~\"$instance\"}[5m]))",
          "legendFormat": "",
          "refId": "A",
          "editorMode": "code",
          "range": true
        }
      ]
    },
