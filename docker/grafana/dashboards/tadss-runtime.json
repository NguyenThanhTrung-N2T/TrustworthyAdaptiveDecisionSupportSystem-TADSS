{
  "uid": "tadss-runtime",
  "title": "TADSS Runtime",
  "description": "Số liệu vận hành của TADSS Decision Runtime: request, quyết định, chịu lỗi, cache, quản trị, tải k6, log và trace.",
  "tags": [
    "tadss"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(tadss_decision_duration_milliseconds_count, instance)",
          "refId": "instance"
        },
        "definition": "label_values(tadss_decision_duration_milliseconds_count, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "chaos",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "red",
        "target": {
          "type": "tags",
          "tags": [
            "chaos"
          ],
          "limit": 100,
          "matchAny": false
        },
        "type": "tags"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "1. Tổng quan",
      "collapsed": false,
