{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      "WithProcessId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "your-connection-string"
  },
  "AllowedHosts": "*",
  "Tadss": {
    "Database": {
      "ApplyMigrationsOnStartup": false
    },
    "Strategies": {
      "Default": {
        "HighValueThreshold": 2000000,
        "NoShowReviewThreshold": 2,
        "StandardDepositRate": 0.5,
        "SilverDepositRate": 0.4,
        "GoldDepositRate": 0.3,
        "PremiumDepositRate": 0.2,
        "CacheTtlMinutes": 60
      },
      "MockAlternative": {
        "HighValueThreshold": 1500000,
        "PeakDepositRate": 0.5,
        "OffPeakDepositRate": 0.3,
        "CacheTtlMinutes": 60
      }
    },
    "Routing": {
      "DefaultStrategy": "DefaultDecisionStrategy",
      "Rules": []
    },
    "Approval": {
      "WindowMinutes": 30,
      "MinLeadMinutes": 120
    },
    "Validation": {
      "MinItemMinutes": 30,
      "MaxItemMinutes": 720
    },
    "Calendar": {
      "PeakWindows": [
        {
          "Day": "Monday",
          "Start": "17:00",
          "End": "21:00"
        },
        {
          "Day": "Tuesday",
          "Start": "17:00",
          "End": "21:00"
        },
        {
          "Day": "Wednesday",
          "Start": "17:00",
          "End": "21:00"
        },
        {
          "Day": "Thursday",
          "Start": "17:00",
          "End": "21:00"
        },
        {
          "Day": "Friday",
          "Start": "17:00",
          "End": "21:00"
        },
        {
          "Day": "Saturday",
          "Start": "08:00",
          "End": "21:00"
        },
        {
          "Day": "Sunday",
          "Start": "08:00",
          "End": "21:00"
        }
      ]
    },
    "Resilience": {
      "OuterTimeoutMs": 500,
      "InnerTimeoutMs": 120,
      "MaxRetryAttempts": 2,
      "RetryBaseDelayMs": 30,
      "CircuitBreakerSamplingSeconds": 30,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerBreakDurationSeconds": 15
    },
    "Cache": {
      "Provider": "Redis",
      "RedisConnectionString": "your-redis-host:11082,user=default,password=your-redis-password",
      "InstanceName": "tadss:",
      "TtlHours": 24,
      "EnableFallbackToMemory": true,
      "RedisTimeoutMs": 150,
      "RedisConnectTimeoutMs": 3000
    },
    "Security": {
      "ApiKeys": [],
      "MaxRequestBodyBytes": 65536,
      "RateLimiting": {
        "PermitLimit": 100,
        "TokensPerPeriod": 100,
        "ReplenishmentPeriodSeconds": 1
      },
      "TrustForwardedHeaders": false
    },
    "ErrorHandling": {
      "RetryAfterSeconds": 5
    },
    "Testing": {
      "FaultInjection": {
        "Enabled": false
      }
    }
  }
}
