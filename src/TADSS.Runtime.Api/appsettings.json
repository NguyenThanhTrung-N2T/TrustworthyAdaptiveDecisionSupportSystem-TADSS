{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      "WithProcessId"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ConnectionStrings": {
    // Giá trị thật: appsettings.Development.json (máy dev, không commit) hoặc biến môi trường ConnectionStrings__DefaultConnection (container/ngrok).
    // Template PostgreSQL (Neon Cloud / Local): "Host=your-db-host;Port=5432;Database=neondb;Username=your-user;Password=your-password;SSL Mode=Require;Trust Server Certificate=true"
    "DefaultConnection": "your-connection-string"
  },
  "AllowedHosts": "*",
  "Tadss": {
    "Database": {
      // Chỉ bật trong docker compose (E-LOCAL); không bật cho Neon/staging
      "ApplyMigrationsOnStartup": false
    },
    "Strategy": {
      // Chiến lược thẩm định hoạt động: "DefaultDecisionStrategy" | "MockAlternativeDecisionStrategy"
      "ActiveStrategyName": "DefaultDecisionStrategy"
    },
    "Strategies": {
      // Tham số của từng strategy (giá trị mặc định). Đổi tham số cần restart ứng dụng;
      // fingerprint tham số (gồm cả lịch cao điểm) đổi theo nên cache cũ tự mất hiệu lực.
      "Default": {
        "HighValueThreshold": 2000000,
        "NoShowReviewThreshold": 2,
        "StandardDepositRate": 0.5,
        "SilverDepositRate": 0.4,
        "GoldDepositRate": 0.3,
        "PremiumDepositRate": 0.2,
        "CacheTtlMinutes": 60
      },
      "MockAlternative": {
        "HighValueThreshold": 1500000,
        "PeakDepositRate": 0.5,
        "OffPeakDepositRate": 0.3,
        "CacheTtlMinutes": 60
      }
    },
    "Approval": {
      // Approval window (phút): thời gian Manager có để duyệt, tính từ lúc đánh giá (phải > 0)
      "WindowMinutes": 30,
      // Thời gian tối thiểu (phút) phải còn lại từ lúc hết approval window đến giờ bắt đầu sớm nhất (>= 0)
      "MinLeadMinutes": 120
    },
    "Validation": {
      // P-01: thời lượng mỗi item (phút), tính cả hai biên; yêu cầu 0 < MinItemMinutes <= MaxItemMinutes
      "MinItemMinutes": 30,
      "MaxItemMinutes": 720
    },
    "Calendar": {
      // Lịch cao điểm theo giờ chi nhánh (SAS 4.3), định dạng HH:mm, Start < End.
      // Khai báo danh sách này sẽ thay thế hoàn toàn mặc định; ghi đè bằng biến môi trường nên cung cấp đủ mọi phần tử.
      "PeakWindows": [
        { "Day": "Monday", "Start": "17:00", "End": "21:00" },
        { "Day": "Tuesday", "Start": "17:00", "End": "21:00" },
        { "Day": "Wednesday", "Start": "17:00", "End": "21:00" },
        { "Day": "Thursday", "Start": "17:00", "End": "21:00" },
        { "Day": "Friday", "Start": "17:00", "End": "21:00" },
        { "Day": "Saturday", "Start": "08:00", "End": "21:00" },
        { "Day": "Sunday", "Start": "08:00", "End": "21:00" }
      ]
    },
    "Resilience": {
      "OuterTimeoutMs": 500,
      "InnerTimeoutMs": 120,
      "MaxRetryAttempts": 2,
      "RetryBaseDelayMs": 30,
      "CircuitBreakerSamplingSeconds": 30,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerBreakDurationSeconds": 15
    },
    "Cache": {
      // Nhà cung cấp Cache: "Redis" (L2 Redis + L1 Memory Fallback) | "Memory" (Chỉ dùng L1 IMemoryCache)
      "Provider": "Redis",
      // Giá trị thật: appsettings.Development.json hoặc biến môi trường Tadss__Cache__RedisConnectionString (container/ngrok).
      // Template Redis Cloud: "your-redis-host:11082,user=default,password=your-redis-password" | Local: "localhost:6379"
      "RedisConnectionString": "your-redis-host:11082,user=default,password=your-redis-password",
      "InstanceName": "tadss:",
      "TtlHours": 24,
      "EnableFallbackToMemory": true,
      "RedisTimeoutMs": 150,
      // Timeout kết nối tối thiểu (ms); timeout kết nối thực tế = max(RedisTimeoutMs, giá trị này), trừ host placeholder (khi đó dùng RedisTimeoutMs)
      "RedisConnectTimeoutMs": 3000
    },
    "ErrorHandling": {
      // Số giây trả trong Retry-After của lỗi tạm thời 503/504 (1..3600)
      "RetryAfterSeconds": 5
    }
  }
}
