        "multi": true,
        "includeAll": true,
        "query": "failed,limited,untested,passed",
        "current": {
          "text": "failed",
          "value": [
            "failed"
          ]
        },
        "options": [
          {
            "text": "failed",
            "value": "failed",
            "selected": true
          },
          {
            "text": "limited",
            "value": "limited",
            "selected": false
          },
          {
            "text": "untested",
            "value": "untested",
            "selected": false
          },
          {
            "text": "passed",
            "value": "passed",
            "selected": false
          }
        ]
